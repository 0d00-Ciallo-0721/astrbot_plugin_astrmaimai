# Copy values into the current PowerShell session; do not commit real secrets.

# AstrBot/AstrMai config files used by the Provider probe.
$env:ASTRMAI_HOST_CMD_CONFIG = "C:\\path\\to\\AstrBot\\data\\cmd_config.json"
$env:ASTRMAI_PLUGIN_CONFIG = "Z:\\ai_robot\\aibot\\AstrBot-4.12.1\\data\\config\\astrmai_config.json"
$env:ASTRMAI_LIVE_SECRETS_FILE = "Z:\\ai_robot\\aibot\\AstrBot-4.12.1\\data\\config\\astrmai_live_secrets.json"

# Provider credentials. The probe stores only a short SHA-256 fingerprint.
$env:ASTRMAI_LIVE_API_KEY = "<provider-api-key>"
$env:ASTRMAI_LIVE_BASE_URL = "https://provider.example/v1"
$env:ASTRMAI_LIVE_MODEL = "openai/deepseek-v4-flash"
$env:ASTRMAI_LIVE_ENVIRONMENT = "staging"
$env:ASTRMAI_LIVE_REGION = "<region>"

# Non-secret model mapping used by AstrMai's plugin config:
# task:     opencode/deepseek-v4-flash
# agent:    opencode/<tool-capable-agent-model>
# fallback: opencode/gpt-5.6-luna, opencode/mimo-v2.5-pro
# vision:   qwen/qwen3-vl-flash
# embed:    openai_embedding (Qwen/Qwen3-Embedding-8B, 4096 dimensions)

# Optional real Host/Gateway probe settings.
$env:ASTRMAI_HOST_BASE_URL = "http://127.0.0.1:<host-port>"
$env:ASTRMAI_HOST_API_PREFIX = "/astrmai/admin"
$env:ASTRMAI_HOST_API_KEY = "<host-api-key>"

# Configure exactly one real event route. Do not invent a private AstrBot path.
$env:ASTRMAI_HOST_EVENT_ADAPTER = "tests.helpers.real_host_adapter:inject"
# $env:ASTRMAI_HOST_EVENT_URL = "http://127.0.0.1:<host-port>/<known-event-route>"

$env:ASTRMAI_HOST_TIMEOUT_SEC = "10"
$env:ASTRMAI_HOST_ADAPTER_TIMEOUT_SEC = "45"
$env:ASTRMAI_HOST_SAMPLE_INTERVAL_SEC = "1"
